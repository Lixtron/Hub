if not game:IsLoaded() then
	game.Loaded:Wait()
end

if getgenv().LixHubLoaded then
	return
end

getgenv().LixHubLoaded = true

local StarterGui = game:GetService("StarterGui")

local scripts = {
	[15009415] = "https://raw.githubusercontent.com/Lixtron/Hub/refs/heads/main/LixHub_ARX",
	[10749844] = "https://raw.githubusercontent.com/Lixtron/Hub/refs/heads/main/LixHub_AG.lua",
	[33861560] = "https://api.luarmor.net/files/v4/loaders/7b964728f0872ba471d90063958fc028.lua",
	[33912907] = "https://raw.githubusercontent.com/Lixtron/Hub/refs/heads/main/LixHub_AO.lua",
	[9190691] = "https://raw.githubusercontent.com/Lixtron/Hub/refs/heads/main/LixHub_AS.lua",
	[17347863] = "https://raw.githubusercontent.com/Lixtron/Hub/refs/heads/main/LixHub_AOTR.lua",
	[35929511] = "https://api.luarmor.net/files/v4/loaders/ed4e6fa2c50ca4ea890bedf40fc647f2.lua",
}

local url = scripts[game.CreatorId]

if not url then
	getgenv().LixHubLoaded = nil

	StarterGui:SetCore("SendNotification", {
		Title = "LixHub",
		Text = "Game not supported",
		Duration = 5,
	})

	return
end

StarterGui:SetCore("SendNotification", {
	Title = "LixHub",
	Text = "Script loading...",
	Duration = 5,
})

loadstring(game:HttpGet(url))()
