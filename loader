if not game:IsLoaded() then
	game.Loaded:Wait()
end

if getgenv().LixHubLoaded then
	return
end

getgenv().LixHubLoaded = true

local StarterGui = game:GetService("StarterGui")

local scripts = {
	[33861560] = "https://api.luarmor.net/files/v4/loaders/7b964728f0872ba471d90063958fc028.lua",
	[9190691] = "https://api.luarmor.net/files/v4/loaders/2687bfdac44a8af920b0137a331c8b33.lua",
	[17347863] = "https://api.luarmor.net/files/v4/loaders/f2874c001b212c6bdc47abb15e07d604.lua",
	[35929511] = "https://api.luarmor.net/files/v4/loaders/ed4e6fa2c50ca4ea890bedf40fc647f2.lua",
}

local url = scripts[game.CreatorId]

if not url then
	getgenv().LixHubLoaded = nil

	StarterGui:SetCore("SendNotification", {
		Title = "LixHub",
		Text = "Game not supported",
		Duration = 5,
	})

	return
end

StarterGui:SetCore("SendNotification", {
	Title = "LixHub",
	Text = "Script loading...",
	Duration = 5,
})

loadstring(game:HttpGet(url))()
